{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "vite-plugin-pwa/client", "chrome"]
  },
  "include": ["src", "cli", "extension/src", "extension/test", "vite.config.ts", "vite.cli.config.ts", "vite.ext.config.ts", "vite.ext-content.config.ts", "vite.docs-addon.config.ts", "docs-addon/src"]
}
