{
  "name": "writewise",
  "productName": "WriteWise",
  "version": "0.1.0",
  "description": "Offline-first writing assistant: grammar, spelling, clarity and tone suggestions as you type.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "build:electron": "cross-env ELECTRON=1 vite build && npm run build:cli && npm run build:axhelper",
    "electron": "npm run build:electron && electron .",
    "dist": "npm run build:electron && electron-builder",
    "dist:mac": "npm run build:electron && electron-builder --mac",
    "dist:win": "npm run build:electron && electron-builder --win",
    "dist:linux": "npm run build:electron && electron-builder --linux",
    "build:cli": "vite build --config vite.cli.config.ts",
    "install:claude-code": "npm run build:cli && node bin/writewise.mjs install-claude-code",
    "uninstall:claude-code": "node bin/writewise.mjs uninstall-claude-code",
    "build:ext": "vite build --config vite.ext.config.ts && vite build --config vite.ext-content.config.ts && node -e \"require('fs').cpSync('public/dict','extension-dist/dict',{recursive:true})\"",
    "pack:ext": "npm run build:ext && node scripts/zip-extension.mjs",
    "build:docs-addon": "vite build --config vite.docs-addon.config.ts && node scripts/build-docs-addon.mjs",
    "test": "npm run build:cli && node --test test/",
    "build:axhelper": "node scripts/build-axhelper.mjs"
  },
  "build": {
    "appId": "app.writewise.desktop",
    "productName": "WriteWise",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "bin/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "extraResources": [
        {
          "from": "native/build/axhelper",
          "to": "axhelper"
        }
      ],
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "afterPack": "scripts/sign-mac.cjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@google/clasp": "^3.4.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/chrome": "^0.3.6",
    "cross-env": "^10.1.0",
    "dictionary-en": "^4.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "nlcst-to-string": "^4.0.0",
    "retext-contractions": "^6.0.0",
    "retext-english": "^5.0.0",
    "retext-equality": "^7.1.0",
    "retext-indefinite-article": "^5.0.0",
    "retext-passive": "^5.0.0",
    "retext-readability": "^8.0.0",
    "retext-redundant-acronyms": "^5.0.0",
    "retext-repeated-words": "^5.0.0",
    "retext-sentence-spacing": "^6.0.0",
    "retext-spell": "^6.1.0",
    "retext-stringify": "^4.0.0",
    "retext-syntax-mentions": "^4.0.0",
    "retext-syntax-urls": "^4.0.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "unist-util-visit-parents": "^6.1.0",
    "vfile": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "zod": "^4.6.7"
  },
  "bin": {
    "writewise": "bin/writewise.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rohansaha/writewise.git"
  },
  "homepage": "https://github.com/rohansaha/writewise#readme"
}
